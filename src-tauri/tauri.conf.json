{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muv-Luv PT-BR Patcher",
  "version": "1.0.0",
  "identifier": "com.gabriexlss.muvluv.ptbr.instalador",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Muv-Luv PT-BR Patcher",
        "width": 980,
        "height": 584,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["PortugueseBR", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
